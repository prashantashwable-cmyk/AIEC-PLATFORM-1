# Copy to .env.local for development. Names only - never commit real secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# PostgreSQL connection string (local Postgres or the Supabase "Session pooler"/direct URL).
DATABASE_URL=postgres://aiec:aiec@localhost:5432/aiec
# Separate database used by the automated integration tests (it is wiped on every run).
TEST_DATABASE_URL=postgres://aiec:aiec@localhost:5432/aiec_test
# "true" enables the clearly labelled sandbox OTP (code shown on screen) and demo sign-in.
# Must be "false" in production once an SMS provider is connected.
AUTH_SANDBOX=true
# Random 32+ character secret used to hash OTPs/sessions and sign reconciliation webhooks.
APP_SECRET=
RECONCILIATION_WEBHOOK_SECRET=
# External providers. Leave empty to keep the labelled sandbox adapters (nothing is sent).
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MAPS_API_KEY=
SENTRY_DSN=
